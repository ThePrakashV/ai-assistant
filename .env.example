ASSISTANT_NAME=Nova
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en

TTS_MODEL_PATH=models/piper/en_US-lessac-medium.onnx
TTS_SPEED=1.0
TTS_VOLUME=1.0

WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_DISPLAY=Hey Jarvis
WAKE_THRESHOLD=0.5
WAKE_ACK_TEXT=Yes?
LISTEN_TIMEOUT=6
FOLLOWUP_TIMEOUT=8

EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
INTENT_THRESHOLD=0.35

REDIS_URL=redis://127.0.0.1:6380/0
FACT_THRESHOLD=0.30
RAG_THRESHOLD=0.40
CHUNK_SIZE=300

DEFAULT_LOCATION=Madurai
HOME_CURRENCY=INR

MLFLOW_TRACKING_URI=http://127.0.0.1:5001
MLFLOW_LOG_TEXT=false

# Empty = no token (localhost only). LAN use na kandippa set pannu
API_TOKEN=

ENCRYPT_AT_REST=true
OFFLINE_MODE=false
DISABLED_SKILLS=
AUDIT_LOG_TEXT=false

# off = verification illa. Enroll + calibrate pannittu enforce
SPEAKER_MODE=off
SPEAKER_MODEL_PATH=models/speaker/wespeaker_en_voxceleb_resnet34_LM.onnx
SPEAKER_THRESHOLD=0.45